# Copia este archivo como .env y escribe tus valores. El archivo .env NO se sube a Git.

# --- PostgreSQL ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=factuguard_ia
DB_ADMIN_NAME=postgres
DB_USER=postgres
DB_PASSWORD=CAMBIAR_POR_TU_CONTRASENA_LOCAL

# --- Aplicación ---------------------------------------------------------------
# En producción es OBLIGATORIA. Genera una con:  py -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=SE_GENERA_AUTOMATICAMENTE_CON_configurar_postgres.py

# --- Empresa (todo lo siguiente es opcional; estos son los valores por defecto) ---
# "produccion" activa: llave secreta obligatoria, cookies seguras, errores genéricos
# y bloqueo del modelo de demostración con facturas reales.
ENTORNO=desarrollo
# Con HTTPS dejar en 1. Si el servidor aún funciona solo con HTTP, poner 0.
COOKIE_SEGURA=1
# Poner 1 si hay un proxy inverso (nginx, IIS, Caddy) delante de la aplicación.
CONFIAR_PROXY=0

# Volumen de carga por la web (para volúmenes mayores usar analizar_lote.py)
MAX_ARCHIVO_MB=50
MAX_FILAS_ARCHIVO=200000

# Reglas y modelos
# Tarifas de IVA aceptadas, en %, separadas por coma. Ejemplo colombiano: 19,5,0
TASAS_IVA_PERMITIDAS=19
# mayoria = alerta si 2 de las 3 IA coinciden (recomendado); cualquiera = basta 1 (más falsas alarmas)
POLITICA_IA=mayoria
# Sensibilidad de Isolation Forest: 0.99 marca ~1 % de lo normal; 0.995 marca menos
PERCENTIL_ALERTA=0.99
MIN_FACTURAS_CALIBRACION=500

# Servidor de producción (servidor_produccion.py)
SERVIDOR_HOST=127.0.0.1
SERVIDOR_PUERTO=8000
SERVIDOR_HILOS=8
